[Unit]
Description=Mandau Core Service
After=network.target docker.service
Requires=docker.service
Wants=docker.service

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/%i/mandau
ExecStart=/usr/local/bin/mandau-core \
    --cert /home/%i/.mandau/certs/core.crt \
    --key /home/%i/.mandau/certs/core.key \
    --ca /home/%i/.mandau/certs/ca.crt \
    --listen :3443
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/.mandau /home/%i/mandau-stacks /tmp

[Install]
WantedBy=multi-user.target